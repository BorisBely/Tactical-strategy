  m_Description: "\u0413\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C \u0434\u043B\u044F
    \u0441\u0435\u0440\u0438\u0438 AK. \u0422\u0438\u0448\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B,
    \u0447\u0443\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F; \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C
    \u2014 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430 \u0441\u043A\u0440\u044B\u0442\u043D\u044B\u0445
    \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432. \u0423\u0442\u044F\u0436\u0435\u043B\u044F\u0435\u0442
    \u043E\u0440\u0443\u0436\u0438\u0435 \u0438 \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442
    \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u0435."
